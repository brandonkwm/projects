{
  "name": "delegated-authority-sg",
  "version": "1.0.0",
  "description": "Proof-of-concept: Singpass delegated financial authority for loss-of-capacity scenarios",
  "main": "server.js",
  "scripts": {
    "start": "concurrently \"npm run mockpass\" \"node server.js\"",
    "mockpass": "cross-env SHOW_LOGIN_PAGE=true SINGPASS_CLIENT_PROFILE=direct mockpass",
    "dev": "concurrently \"npm run mockpass\" \"node --watch server.js\""
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "express-session": "^1.17.0"
  },
  "devDependencies": {
    "@opengovsg/mockpass": "^4.6.5",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
