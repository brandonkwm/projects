# ─── MockPass (runs as a separate process on port 5156) ───────────────────────
MOCKPASS_PORT=5156

# CRITICAL: skip JWE encryption on ID tokens — without this, MockPass encrypts
# the token and you need a hosted JWKS endpoint + key pair to decrypt it.
SINGPASS_CLIENT_PROFILE=direct

# Renders a NRIC dropdown at the MockPass login page (great for demos)
SHOW_LOGIN_PAGE=true

# ─── Your Express app ─────────────────────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ─── OIDC Client ──────────────────────────────────────────────────────────────
# MockPass accepts any values here — these are just for consistency
OIDC_CLIENT_ID=delegated-authority-demo
OIDC_CLIENT_SECRET=not-a-real-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
MOCKPASS_BASE_URL=http://localhost:5156
